# dependencies
/node_modules

# next.js
# Glob rather than exact names: build dirs have appeared as .next, .next(1)
# and .next-agent, and every one of them has been swept into a commit by a
# stray `git add -A` at least once.
/.next*/
/out/
# agent dev server's separate build dir (see "dev:agent" in package.json --
# avoids EBUSY contention when a human and an agent run dev at the same time)
# -- covered by the glob above, kept for the explanation.

# agent/tooling scratch and generated output, none of it source
/.agents/
/prototypes/
/scripts/output/
/.asset-match/

# Archives. sorted-and-stocked-code.zip.zip has sat untracked in the repo
# root for weeks and was committed by accident on 28 Jul (reverted before
# it could spread). A source repo has no reason to carry a zip of itself.
*.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# local dev notes (may contain test credentials -- never commit)
DEV_NOTES.local.md

# typescript
*.tsbuildinfo
next-env.d.ts

# pwa generated files
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/sw.js.map
/public/workbox-*.js.map
/public/worker-*.js.map
