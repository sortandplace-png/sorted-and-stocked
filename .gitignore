# dependencies
/node_modules

# next.js
/.next/
/out/
# agent dev server's separate build dir (see "dev:agent" in package.json --
# avoids EBUSY contention when a human and an agent run dev at the same time)
/.next-agent/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# local dev notes (may contain test credentials -- never commit)
DEV_NOTES.local.md

# typescript
*.tsbuildinfo
next-env.d.ts

# pwa generated files
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/sw.js.map
/public/workbox-*.js.map
/public/worker-*.js.map
